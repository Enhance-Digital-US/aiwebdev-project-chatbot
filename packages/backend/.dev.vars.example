# Local secrets and overrides for `wrangler dev`.
# Copy to .dev.vars (gitignored) and fill in your own values:
#   cp .dev.vars.example .dev.vars
# Values here override `vars` in wrangler.jsonc. In production, set secrets
# with `wrangler secret put <NAME>` instead.

# --- Required ---------------------------------------------------------------

# OpenAI: chat model + the Moderation API used by the "simple" guardrail tier
OPENAI_API_KEY=sk-your-openai-key

# Cloudflare AI Gateway: every OpenAI call goes through it. Account id and
# gateway name are in wrangler.jsonc vars (override them here for your own
# gateway); the token comes from the gateway's Settings → Authentication.
AI_GATEWAY_TOKEN=your-ai-gateway-token
# AI_GATEWAY_ACCOUNT_ID=your-cloudflare-account-id
# AI_GATEWAY_NAME=your-gateway-name

# Langfuse tracing (https://langfuse.com → project settings → API keys)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# --- Optional ---------------------------------------------------------------

# `pnpm dev` already passes --var ENVIRONMENT:development. Set it here too if
# you run `wrangler dev` directly (e.g. in CI).
ENVIRONMENT=development

# Issue-tracker persona for local dev tokens (the tracker runs on :8787):
# user-alice (admin), user-bob (member, default), user-carol (viewer)
ISSUE_TRACKER_PERSONA=user-bob

# Langfuse region host (default: https://us.cloud.langfuse.com)
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# MCP client implementation: "raw" (default) or "ai-sdk"
MCP_IMPL=raw

# Guardrail tier: simple | local | cloud | none
# "local" needs Ollama running with llama-guard3
GUARDRAIL_TIER=simple

# Ollama URL for the gemma4:12b model and the "local" guardrail tier
OLLAMA_BASE_URL=http://localhost:11434

# Code execution sandbox: "e2b", "cloudflare", or empty for the stub
SANDBOX_PROVIDER=
# Required when SANDBOX_PROVIDER=e2b
E2B_API_KEY=

# Cloudflare Access (set in wrangler.jsonc vars; leave empty locally, where
# there is no Access JWT and traces carry no user id)
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
