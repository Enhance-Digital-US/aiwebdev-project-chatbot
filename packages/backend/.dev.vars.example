# Local secrets and overrides for `wrangler dev`.
# Copy to .dev.vars (gitignored) and fill in your own values:
#   cp .dev.vars.example .dev.vars
# Values here override `vars` in wrangler.jsonc. In production, set secrets
# with `wrangler secret put <NAME>` instead.

# --- Required ---------------------------------------------------------------

# OpenAI: the chat model
OPENAI_API_KEY=sk-your-openai-key

# Cloudflare AI Gateway: every OpenAI call goes through it. Account id and
# gateway name are in wrangler.jsonc vars (override them here for your own
# gateway); the token comes from the gateway's Settings → Authentication.
AI_GATEWAY_TOKEN=your-ai-gateway-token
# AI_GATEWAY_ACCOUNT_ID=your-cloudflare-account-id
# AI_GATEWAY_NAME=your-gateway-name
