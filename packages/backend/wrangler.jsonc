{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],

  // Workers Custom Domain: wrangler deploy creates the DNS record and a per-host
  // certificate (covers this 2-level subdomain; no Advanced Certificate Manager needed).
  "routes": [
    { "pattern": "chatbot.course-projects.ai-web.dev", "custom_domain": true }
  ],
  // The custom domain is the only public origin (spec D8): Cloudflare Access protects
  // that hostname, so workers.dev and preview URLs would bypass login.
  "workers_dev": false,
  "preview_urls": false,

  // 8787 is reserved for the course's issue-tracker MCP server, which rejects any
  // other Host. The Vite proxy and the evals provider point here.
  "dev": {
    "port": 8788
  },

  // Single-Worker deployment: the Vite build is served as static assets and
  // only /api/* reaches the Hono app. Everything else falls back to index.html
  // so TanStack Router can handle client-side routes.
  // Build the frontend first (`pnpm build` at the root does this).
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // Overridden to "development" by `pnpm dev` (--var). Dev-only behavior, such as
    // issue-tracker dev tokens, keys off this, because wrangler dev rewrites the
    // request host to the custom domain.
    "ENVIRONMENT": "production",
    // Cloudflare AI Gateway that every hosted model call goes through.
    // The gateway is authenticated: set the AI_GATEWAY_TOKEN secret.
    "AI_GATEWAY_ACCOUNT_ID": "9dff37a609d16c31de78f32f94783041",
    "AI_GATEWAY_NAME": "default",
    "MCP_IMPL": "raw",
    // Set to "e2b" or "cloudflare" to enable real sandbox execution (default: stub)
    // "e2b" requires the E2B_API_KEY secret.
    "SANDBOX_PROVIDER": "e2b",
    // "local" cannot work when deployed (no Ollama at the edge). .dev.vars overrides this locally.
    "GUARDRAIL_TIER": "simple",
    // Cloudflare Access (Clerk as OIDC IdP) enforces login at the edge. These identify
    // the Access JWT issuer/audience so the Worker can read the user for Langfuse traces.
    "ACCESS_TEAM_DOMAIN": "https://enhancedigital.cloudflareaccess.com",
    "ACCESS_AUD": "7348bba1294ed0017d9bcf4366c73a2ddb4402b72c8f4c79b29785e714114137"
  },

  // Workers AI binding for cloud guardrail tier (Llama Guard)
  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true
  },

  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ]

  // Secrets (set with `wrangler secret put <NAME>`, never commit):
  //   OPENAI_API_KEY, AI_GATEWAY_TOKEN, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY,
  //   E2B_API_KEY
}
