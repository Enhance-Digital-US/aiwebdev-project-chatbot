{
  "name": "chatbot-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "MCP_IMPL": "raw",
    // Set to "e2b" or "cloudflare" to enable real sandbox execution (default: stub)
    "SANDBOX_PROVIDER": "e2b"
  },

  // Workers AI binding for cloud guardrail tier (Llama Guard)
  "ai": {
    "binding": "AI"
  },

  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ]
}
