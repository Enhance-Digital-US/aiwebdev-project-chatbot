{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],

  // 8787 is reserved for the course's issue-tracker MCP server, which rejects any
  // other Host. The Vite proxy points here.
  "dev": {
    "port": 8788
  },

  // Single-Worker deployment: the Vite build is served as static assets and
  // only /api/* reaches the Hono app. Everything else falls back to index.html
  // so TanStack Router can handle client-side routes.
  // Build the frontend first (`pnpm build` at the root does this).
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // Overridden to "development" by `pnpm dev` (--var). Dev-only behavior, such as
    // issue-tracker dev tokens, keys off this, because wrangler dev rewrites the
    // request host to the custom domain.
    "ENVIRONMENT": "production",
    // The course's hosted issue tracker (an Access bypass covers this host).
    // `pnpm dev` points at the local tracker instead (--var).
    "ISSUE_TRACKER_URL": "https://issue-tracker-mcp-production.enhancedigital.workers.dev/mcp",
    // Cloudflare AI Gateway that every hosted model call goes through.
    // The gateway is authenticated: set the AI_GATEWAY_TOKEN secret.
    "AI_GATEWAY_ACCOUNT_ID": "9dff37a609d16c31de78f32f94783041",
    "AI_GATEWAY_NAME": "default",
    "MCP_IMPL": "raw",
    // Set to "e2b" or "cloudflare" to enable real sandbox execution (default: stub)
    // "e2b" requires the E2B_API_KEY secret.
    "SANDBOX_PROVIDER": "e2b",
    // "local" cannot work when deployed (no Ollama at the edge). .dev.vars overrides this locally.
    "GUARDRAIL_TIER": "simple"
  },

  // Bug-report workflow (lesson 16): redact → draft → dedupe → approval → file.
  "workflows": [
    { "name": "bug-report", "binding": "BUG_REPORT", "class_name": "BugReportWorkflow" }
  ],

  // D1: bug-report progress for the workflow card (lesson 16). Apply the schema with
  //   npx wrangler d1 migrations apply chatbot --local    (and --remote once deployed)
  // No database_id yet: local dev doesn't need one. Run `npx wrangler d1 create chatbot`
  // and paste its id here before the first deploy that uses it.
  "d1_databases": [
    { "binding": "DB", "database_name": "chatbot", "migrations_dir": "migrations" }
  ],

  // Workers AI binding for cloud guardrail tier (Llama Guard)
  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true
  },

  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ]
}
