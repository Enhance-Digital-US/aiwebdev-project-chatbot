# Optional Clerk auth. Inlined at BUILD time by Vite (not read at Worker runtime),
# so it must be present when running `pnpm build` / `pnpm run deploy`.
# Publishable keys are public — committing a `.env.production` with it is fine.
# pk_test_ (Clerk dev instance) works on *.workers.dev; pk_live_ requires a custom domain.
VITE_CLERK_PUBLISHABLE_KEY=
